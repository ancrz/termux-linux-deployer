# ============================================
# termux-linux-deployer Environment Variables
# ============================================
# Copy this file to .env, restrict it to owner access (`chmod 600 .env`),
# and replace every placeholder with values for your own environment.
# Sourced by scripts/termux/login-ubuntu.sh
# and passed into proot via --env flags.
# ============================================

# --- GitHub ---
GITHUB_PERSONAL_ACCESS_TOKEN=REPLACE_WITH_GITHUB_TOKEN
GITHUB_USERNAME=REPLACE_WITH_GITHUB_USERNAME

# --- Code-Server ---
CS_PASSWORD=REPLACE_WITH_STRONG_CODE_SERVER_PASSWORD
CS_PORT=8443

# --- Code-Server TLS ---
# auto = self-signed cert (recommended), custom = your cert, none = no TLS
CS_CERT_MODE=none
CS_CERT_FILE=

# --- Code-Server Tuning ---
CS_HEARTBEAT_INTERVAL=60
CS_MEMORY_LIMIT=3072
CS_DISABLE_FILE_DOWNLOADS=false

# --- Git Identity ---
GIT_USER_NAME=REPLACE_WITH_YOUR_NAME
GIT_USER_EMAIL=REPLACE_WITH_YOUR_EMAIL

# --- Google OAuth2 (GCP Project) ---
# Obtain via Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# --- Skill-Swarm ---
# Defaults to GITHUB_PERSONAL_ACCESS_TOKEN if not set
SKILL_SWARM_GITHUB_TOKEN=${GITHUB_PERSONAL_ACCESS_TOKEN}

# --- Paths (defaults, override if needed) ---
PROOT_HOME=/root
# Defaults to the detected $HOME/Documents (and creates workspaces/ if absent).
WORKSPACE_DIR=REPLACE_WITH_OPTIONAL_WORKSPACE_DIRECTORY

# --- Node.js ---
NODE_TARGET_MAJOR=22

# --- Python ---
PYTHON_DEFAULT_VERSION=3.14

# --- Antigravity CLI (agy) ---
# Installed via community Termux patcher
AGY_REPO=wallentx/antigravity-cli-termux

# --- Go ---
GO_VERSION=1.24.2

# --- Temp directory (proot compatibility) ---
TMPDIR=/tmp
