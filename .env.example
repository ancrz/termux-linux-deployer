# ============================================
# termux-linux-deployer Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# Sourced by scripts/termux/login-ubuntu.sh
# and passed into proot via --env flags.
# ============================================

# --- GitHub ---
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
GITHUB_USERNAME=your_github_username

# --- Code-Server ---
CS_PASSWORD=your_code_server_password
CS_PORT=8443

# --- Git Identity ---
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email@example.com

# --- Google OAuth2 (GCP Project) ---
# Obtain via Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_secret_here

# --- Skill-Swarm ---
# Defaults to GITHUB_PERSONAL_ACCESS_TOKEN if not set
SKILL_SWARM_GITHUB_TOKEN=${GITHUB_PERSONAL_ACCESS_TOKEN}

# --- Paths (defaults, override if needed) ---
PROOT_HOME=/root
WORKSPACE_DIR=/root/home/Documents

# --- Node.js ---
NODE_TARGET_MAJOR=22

# --- Python ---
PYTHON_DEFAULT_VERSION=3.14

# --- Go ---
GO_VERSION=1.24.2

# --- Temp directory (proot compatibility) ---
TMPDIR=/tmp
