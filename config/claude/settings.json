{
  "permissions": {
    "_permissions_note": "bypassPermissions is safe here: this runs as root inside proot-distro Ubuntu on Termux. proot does not expose real kernel root — it is a user-space chroot. There is no privilege escalation risk. This is a single-user, single-device development environment.",
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "semgrep@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "github-mcp-server": {
      "command": "/root/.local/bin/github-mcp-server",
      "args": [
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "skill-swarm": {
      "command": "/root/.local/share/skill-swarm/.venv/bin/python",
      "args": [
        "-m",
        "skill_swarm.server"
      ],
      "env": {
        "SKILL_SWARM_GITHUB_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "bash /root/.claude/statusline-command.sh"
  }
}
