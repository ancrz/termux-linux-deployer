# Keep repository text portable across Termux, Linux, and GitHub.
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.env.example text eol=lf

# Documentation is local-only and must not be packaged if it is reintroduced.
docs/** export-ignore
